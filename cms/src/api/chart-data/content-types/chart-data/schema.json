    "y_values": {
      "type": "json",
      "required": true
    },
    "layer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::layer.layer",
      "inversedBy": "chart_data"
    },
    "unique_identifier": {
      "type": "string"
    }
  }
}
