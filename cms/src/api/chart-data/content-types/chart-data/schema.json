{
  "kind": "collectionType",
  "collectionName": "chart_datas",
  "info": {
    "singularName": "chart-data",
    "pluralName": "chart-datas",
    "displayName": "Chart Data",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "location_code": {
      "type": "string",
      "required": false
    },
    "year": {
