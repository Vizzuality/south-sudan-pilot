{
  "kind": "collectionType",
  "collectionName": "datasets",
  "info": {
    "singularName": "dataset",
    "pluralName": "datasets",
    "displayName": "Dataset",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "layers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::layer.layer"
    },
    "default_layer": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::layer.layer"
    },
    "topic": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::topic.topic"
    },
    "sub_topic": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::sub-topic.sub-topic"
    },
    "metadata": {
      "type": "component",
      "repeatable": false,
      "component": "metadata.item"
    },
    "short_description": {
      "type": "text",
      "maxLength": 100
    },
    "order": {
      "type": "integer"
    }
  }
}
